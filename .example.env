############################################################
# Example .env.
# This is an example .env file. Copy this file to .env and fill in the values.
############################################################

# Your GitHub username and email. These will be used to pull packages from GitHub
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your@githubemail.local

# Path to a token that should have the scope read:packages.
GITHUB_TOKEN=ghp_***************************************